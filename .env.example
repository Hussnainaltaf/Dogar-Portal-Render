# ============================================================
# Dogar Portal — Environment Variables  (M-04: deployment guide)
# ============================================================
# Copy this file to .env and fill in every value before first run.
# NEVER commit .env to version control (it is listed in .gitignore).
# ============================================================

# ── Core ─────────────────────────────────────────────────────
# Must be set to "production" on live servers.
# Controls: API docs visibility, password-strength enforcement,
#           weak-SECRET_KEY rejection, and startup safety checks.
ENV=production

# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
# Must be at least 32 characters in production.
#
# DEV / STAGING (ENV != "production"): if this is left blank or at the
# placeholder, the app auto-generates an ephemeral 64-char random key at
# startup and logs a WARNING. Sessions won't survive a restart, but the
# fresh clone boots with zero config — no more "not plug-and-play" gate.
# PRODUCTION: hard-fails at boot with a clear SECURITY BLOCKER message.
SECRET_KEY=REPLACE_ME_with_a_64_char_random_hex_string

# ── Bootstrap Admin (first-run only) ─────────────────────────
DEFAULT_ADMIN_EMAIL=admin@yourcompany.com
DEFAULT_ADMIN_PASSWORD=ChangeMe_AtFirstLogin_12chars!
DEFAULT_ADMIN_NAME=Administrator

# ── Vendor / Developer Super-Admin (C-03 fix) ────────────────
# Replaces the vendor account that earlier builds hardcoded in source.
# Nothing is hardcoded any more: these env vars are the only source.
# Must be set in production — app will refuse to start without them.
# Password must be at least 16 characters.
# The password is applied only when the account is first created, so the
# operator can change or revoke it afterwards and the change sticks.
VENDOR_ADMIN_EMAIL=vendor@hussnaintechvertex.com
VENDOR_ADMIN_PASSWORD=REPLACE_ME_strong_vendor_password_16chars!
VENDOR_ADMIN_NAME=Vendor Support

# ── Company branding ─────────────────────────────────────────
COMPANY_NAME=Your Company Name
COMPANY_TAGLINE=Your Tagline

# ── Database (SQLite default — change path per environment) ──
DATABASE_URL=sqlite:///./data/dogar_trading.db

# ── Optional — AI chatbot (DtcBot) ───────────────────────────
OPENAI_API_KEY=
OPENAI_BASE_URL=

# ── Email / SMTP (required for password-reset flow) ──────────
# Password reset is the ONLY feature that needs SMTP. Everything else runs
# without it.
#
# The values below are PLACEHOLDERS and the app knows it: config.py keeps a
# list of well-known placeholder strings (smtp.yourprovider.com,
# your_smtp_password, noreply@yourcompany.com, ...) and treats SMTP as
# NOT configured whenever it sees one. Consequences while unreplaced:
#   * a WARNING is logged at boot,
#   * GET /api/health reports
#     "password_reset": "unavailable_smtp_not_configured",
#   * POST /api/auth/forgot-password returns HTTP 503 with an actionable
#     message pointing the user at the support contact page.
#
# Replace all four with REAL provider credentials to switch the feature on.
#
# SECURITY NOTE (fixed 2026-07-26): this endpoint deliberately returns the
# SAME account-neutral response whether or not the address is registered,
# and a send failure is logged server-side instead of surfacing as HTTP 500.
# An earlier build returned 500 only for registered addresses, which made the
# status code an account-enumeration oracle. Do not "helpfully" reintroduce a
# distinct error path for known addresses.
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_USER=noreply@yourcompany.com
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=noreply@yourcompany.com
SMTP_TLS=true

# ── Twilio SMS / WhatsApp (real messaging — Task 9) ──────────
# Server-side ONLY: these credentials are never exposed to the browser. The
# portal's /api/messaging/* endpoints use them behind the auth layer to send
# real WhatsApp / SMS messages to candidates (replacing the old wa.me links).
# Leave BLANK to run in safe "dry-run" mode — messages are logged but not sent
# (and no Twilio cost is incurred), which is ideal for demos and testing.
#
# 1. Sign up at https://www.twilio.com/ and copy your Account SID + Auth Token.
# 2. For SMS: buy/verify a phone number (E.164, e.g. +12025550123).
# 3. For WhatsApp: enable the WhatsApp sender (sandbox or approved sender).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=            # e.g. +12025550123  (your Twilio SMS number)
TWILIO_WHATSAPP_FROM=       # e.g. +14155238886  ("whatsapp:" prefix added automatically)
TWILIO_MESSAGING_SERVICE_SID=   # optional — overrides TWILIO_SMS_FROM for SMS

# ── Host allowlist & proxy trust (security) ──────────────────
# Comma-separated Host header allowlist (TrustedHostMiddleware). The shipped
# default trusts ONLY loopback + the app's own domains. Broad shared-PaaS
# wildcards (*.railway.app, *.onrender.com, *.fly.dev) are NOT
# trusted by default and are added only in non-production or when a managed
# sandbox is detected. Set this to YOUR real public domain(s) in production.
ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.com,*.your-domain.com

# Set to "true" only if you intentionally run on a preview PaaS and want the
# preview/sandbox wildcards re-enabled in production. Leave unset otherwise.
ALLOW_PREVIEW_HOSTS=

# Extra comma-separated Host-allowlist wildcards to trust in preview/sandbox
# mode (added on top of the built-in preview list). Example: *.example-paas.io
EXTRA_PREVIEW_HOSTS=

# Extra space-separated CSP frame-ancestors sources allowed in preview mode
# (lets a hosting dashboard embed the app in an iframe). Example: https://*.example-paas.io
EXTRA_FRAME_ANCESTORS=

# Optional path to a local YAML file holding the LLM API key/base URL for the
# DTC assistant (fallback when OPENAI_API_KEY env is not set).
LLM_CONFIG_FILE=~/.llm_config.yaml

# Number of trusted reverse proxies in front of the app that append a
# trustworthy X-Forwarded-For entry. Governs the login brute-force IP throttle.
#   0 = direct exposure / untrusted XFF (SAFE DEFAULT — uses the socket peer)
#   1 = one trusted proxy (e.g. a single nginx / load balancer)
# Setting this too high lets clients spoof their IP and evade the lockout;
# setting it too low is always safe (falls back to the real socket peer).
TRUSTED_PROXY_COUNT=0
